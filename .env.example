# Copy to .env and fill in. .env is gitignored; this file is the committed template.
# Never put a real value here.
#
# Get a Gemini key at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Any non-empty value. Proves credential injection: Warden holds it, strips it from
# the schema the agent sees, and injects it after the authorization decision.
DEMO_EMAIL_API_KEY=
